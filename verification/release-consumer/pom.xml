<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.rebelcraft.validation</groupId>
    <artifactId>j2html-toolkit-release-consumer</artifactId>
    <version>1.0.0</version>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.teggr</groupId>
                <artifactId>j2html-toolkit-bom</artifactId>
                <version>0.0.5</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.github.teggr</groupId>
            <artifactId>j2html-toolkit-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.teggr</groupId>
            <artifactId>j2html-toolkit-integration-bootstrap</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.teggr</groupId>
            <artifactId>j2html-toolkit-integration-htmx</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.teggr</groupId>
            <artifactId>j2html-toolkit-components-ai</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
        </plugins>
    </build>
</project>
